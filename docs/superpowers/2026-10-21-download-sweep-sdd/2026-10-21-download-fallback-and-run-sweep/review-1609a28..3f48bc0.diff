+    result = runner.invoke(cli.app, ["--config", cfg, "get", "GD", "--name", "mine"])
+    assert result.exit_code == 0, result.output
+    assert ws.dir.is_dir() and ws.request.exists()
+    assert taken == [(True, False)]               # created here: blocking
+    assert probes == ["held"]
