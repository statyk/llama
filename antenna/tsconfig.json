{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["@cloudflare/vitest-plugin/types", "vite/client"]
  },
  "include": ["src", "test", "public", "worker-configuration.d.ts"]
}
