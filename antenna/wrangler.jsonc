{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antenna",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Cron-only: no routes, no fetch handler, and no public URL. A routeless
  // Worker otherwise gets a public, billed *.workers.dev URL that the zone's
  // WAF kill switch cannot reach (spec "Architecture").
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  // The bucket name must match transmitter's [publish] bucket.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lma-radio" }],
  "vars": {
    // Players start PLAYLIST_HOLD_BACK segments before the listed end, and the
    // window lists PLAYLIST_LOOKAHEAD past the one airing: equal, players sit
    // at the wall clock with ~123 s of listed runway against a late cron fire
    // (measured lag up to 117 s). Keep them equal: hugo's dead-clock check
    // dates live.m3u8 by its newest segment minus the hold-back. Amendment A4
    // (amended 2026-10-12); docs/playout-setup.md.
    "PLAYLIST_WINDOW": "16",
    "PLAYLIST_LOOKAHEAD": "12",
    "PLAYLIST_HOLD_BACK": "12",
    "GRACE_SEGMENTS": "3",
    "OFFAIR_AFTER_SECONDS": "86400",
    "LOOP_SECONDS": "75",
    "LIVE_MAX_AGE": "5",
    "LEAD_FLOOR_HOURS": "16",
    // The cost guard (spec "Cost guard"). MONTHLY_BUDGET_USD includes the $5
    // Workers Paid base; the billing period starts on BILLING_ANNIVERSARY_DAY
    // at 00:00 UTC. Account details are Worker secrets, never here:
    // CF_ACCOUNT_ID, CF_ZONE_ID, CF_ANALYTICS_TOKEN, CF_WAF_TOKEN
    // (see docs/playout-setup.md).
    "MONTHLY_BUDGET_USD": "15",
    "BILLING_ANNIVERSARY_DAY": "11",
    "GUARD_EVAL_SECONDS": "900",
    "BLIND_AFTER_SECONDS": "21600",
    "KILL_SWITCH_DESCRIPTION": "station: kill switch",
    // Cloud alerts go by email through the ALERT_EMAIL send_email binding, from
    // ALERT_EMAIL_FROM to ALERT_EMAIL_TO (secrets), and are appended to the R2
    // object state/alert-relay.json, which hugo relays to its ntfy (the Worker
    // sends no ntfy). Never put an address in this file.
    "ALERT_REPEAT_HOURS": "6",
    "STATION_NAME": "llama radio",
    // The rollback switch (metronome spec): only the exact string "on" enables
    // the metronome. Anything else is off: cron runs its own loop exactly as
    // before, and the Durable Object deletes its alarm and writes nothing.
    // docs/playout-setup.md section 4 step 7 has the rollout and the rollback.
    "METRONOME": "on"
  },
  // The metronome (docs/superpowers/specs/2026-10-14-antenna-metronome-design.md):
  // a SQLite-backed Durable Object that writes live.m3u8 on the grid from an
  // alarm chain under a lease cron renews every minute. One instance, addressed
  // as idFromName("metronome"). Migration form: `migrations` with
  // `new_sqlite_classes`, the form the alarm probe deployed with this wrangler
  // (4.149.0); the declarative `exports` field is the newer alternative, and the
  // two are mutually exclusive. Both pass `wrangler deploy --dry-run`.
  "durable_objects": { "bindings": [{ "name": "METRONOME_DO", "class_name": "Metronome" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Metronome"] }],
  // Alert email (Email Routing). Unrestricted on purpose: a send_email binding
  // can only reach the account's verified destination addresses, and the one
  // used is the ALERT_EMAIL_TO secret. Never put an address in this file.
  "send_email": [{ "name": "ALERT_EMAIL" }],
  // Workers Logs: one clock line per cron invocation (~1,440/day), plus the
  // metronome's: each Durable Object invocation (alarm or renew) is itself a
  // log event (~10k/day), and the object logs only anomalies, once per episode.
  // All far inside the included allowance.
  "observability": { "enabled": true }
}
